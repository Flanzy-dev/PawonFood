{
  "name": "pawonfood-render",
  "version": "0.1.0",
  "private": true,
  "description": "Headless render engine: paints every frame on a canvas, captures it in headless Chrome and encodes an MP4 with ffmpeg.",
  "type": "module",
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "render": "node render.mjs",
    "render:portrait": "node render.mjs --portrait",
    "audio:ad": "node audio/ad-audio.mjs",
    "render:ad": "node audio/ad-audio.mjs && node render.mjs --comp ad",
    "review:ad": "node review.mjs",
    "test": "node --test",
    "preview": "node server.mjs"
  }
}
