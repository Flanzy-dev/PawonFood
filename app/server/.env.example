# Copy to .env (git-ignored) and fill in. Never commit the real key.

# Alibaba Cloud Model Studio (DashScope) API key. Required unless QWEN_PROVIDER=fake.
QWEN_API_KEY=

# OpenAI-compatible base URL. The default is the international endpoint; use the URL of the region your key belongs to
# (Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1).
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Vision model id from the Model Studio model list.
QWEN_MODEL=qwen3-vl-plus

# Upstream timeout per request, in milliseconds.
QWEN_TIMEOUT_MS=20000

# Optional. Sent as `reasoning_effort` when set. Leave empty for Model Studio.
QWEN_REASONING_EFFORT=

# --- Local alternative: Ollama on this machine (no account, no cost) ---
# ollama pull qwen3.5:4b   (vision capable; check with: ollama show qwen3.5:4b)
# QWEN_API_KEY=ollama                       # any non-empty value; Ollama ignores it
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen3.5:4b
# QWEN_REASONING_EFFORT=none                # required: with thinking on, the model never reaches the JSON
# QWEN_TIMEOUT_MS=60000                     # the first photo also loads the model

# "qwen" (default) or "fake". The fake provider answers every photo with a fixed cooked-food observation, for local
# development without a key. It is refused when NODE_ENV=production.
QWEN_PROVIDER=qwen

# HTTP server.
PORT=8787
HOST=0.0.0.0

# Upload limits.
MAX_UPLOAD_BYTES=5242880

# Requests per minute per client IP.
RATE_LIMIT_PER_MIN=10

# Set to 1 only behind a reverse proxy you control (Render, Railway, Fly), so the client IP is read from X-Forwarded-For.
TRUST_PROXY=0

# Optional shared token. When set, requests must send it in the X-Pawon-Client header. The app embeds it, so it only
# keeps out casual traffic; real auth comes with Supabase.
PAWON_CLIENT_TOKEN=
